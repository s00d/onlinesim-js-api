{
  "name": "onlinesim-js-api",
  "version": "2.0.0",
  "description": "Typed, zero-dependency client for the OnlineSim API (SMS numbers, rent, account, free numbers)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests",
    "test:watch": "vitest --dir tests",
    "test:integration": "vitest run tests/integration.test.ts",
    "smoke": "node tests/smoke-dist.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/onlinesim-js-api.git"
  },
  "bugs": {
    "url": "https://github.com/s00d/onlinesim-js-api/issues"
  },
  "homepage": "https://s00d.github.io/onlinesim-js-api/",
  "keywords": [
    "onlinesim",
    "sms",
    "virtual-number",
    "sms-activation",
    "api",
    "typescript"
  ],
  "author": "s00d",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
